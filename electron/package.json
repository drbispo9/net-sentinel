{
  "name": "netsentinel",
  "version": "1.0.0",
  "description": "NetSentinel Desktop",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "electron": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.netsentinel.app",
    "productName": "NetSentinel",
    "icon": "assets/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "config.html",
      "start.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "app",
        "filter": [
          "**/*",
          "!electron/**",
          "!**/__pycache__/**",
          "!**/.git/**",
          "!**/node_modules/**"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
