# ── Banco de dados ──────────────────────────────────────────────
# >>> RODANDO VIA DOCKER COMPOSE: edite SOMENTE as 3 linhas abaixo. <<<
# O compose injeta estas credenciais tanto no container do Postgres quanto no
# backend (monta o DATABASE_URL sozinho, usando o host "postgres"). Em produção,
# troque POSTGRES_PASSWORD por uma senha forte e única.
POSTGRES_USER=netsentinel
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=netsentinel

# DATABASE_URL — usado APENAS se você rodar o backend direto no host (SEM Docker).
# Via Docker Compose esta linha é IGNORADA. Se usar no host, a senha aqui deve
# ser a mesma do POSTGRES_PASSWORD acima.
DATABASE_URL=postgresql+asyncpg://netsentinel:troque-por-uma-senha-forte@localhost:5432/netsentinel
# SQLite (fallback rápido p/ desenvolvimento, sem servidor):
# DATABASE_URL=sqlite+aiosqlite:///./netsentinel.db

# Pool de conexões (aplicado só no PostgreSQL). Padrões abaixo.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ── Segurança ───────────────────────────────────────────────────
# Chave exigida nos endpoints de escrita (POST/PUT/DELETE), enviada
# pelo frontend no header X-API-Key. Se ficar VAZIA, a escrita fica
# ABERTA (sem autenticação). Defina um valor forte em produção.
API_KEY=troque-por-uma-chave-forte

# Origens permitidas no CORS, separadas por vírgula. "*" libera todas.
# Como a autenticação é por header (não cookie), "*" é seguro aqui.
CORS_ORIGINS=*

# ── Monitoramento de banco (locks) — todas opcionais ────────────
# Intervalo entre checagens dos monitores de banco (segundos). Padrão: 30.
DB_MONITOR_INTERVAL_SECONDS=30
# Ignora bloqueios com waitTime abaixo desse valor (ms). 0 = conta todos.
DB_LOCK_MIN_WAIT_MS=0
# Marca WARNING se 'updatedAt' da Sentinela ficar mais velho que isso (s).
# 0 = checagem de dados desatualizados desabilitada.
DB_DATA_MAX_AGE_SECONDS=0

# ── Portal OAB — check L7 autenticado (opcional) ────────────────
PORTAL_OAB_AUTH_URL=https://appws.oabgo.org.br/wsapp/wsapp/authenticate
PORTAL_OAB_USERNAME=seu_usuario_oab
PORTAL_OAB_PASSWORD=sua_senha_oab
